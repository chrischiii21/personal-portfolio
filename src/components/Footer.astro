---
const { profile } = Astro.props;
---
<footer class="max-w-6xl mx-auto px-6 py-12 border-t border-white/5 flex flex-col md:flex-row justify-between items-center gap-6 opacity-40">
    <p class="text-xs font-mono uppercase tracking-widest tracking-tighter">
        &copy; {new Date().getFullYear()} {profile.name}
    </p>
    <p class="text-[10px] font-mono">
        Built with Astro & TypeScript
    </p>
</footer>
