---
const { experience } = Astro.props;
---
<section id="experience">
    <h2 class="heading text-sm font-bold uppercase tracking-[0.2em] text-blue-500 mb-10 flex items-center gap-4">
        Experience
        <div class="h-px flex-1 bg-white/5"></div>
    </h2>
    <div class="space-y-12">
        {experience.map(job => (
            <div class="group relative">
                <div class="flex flex-col md:flex-row md:justify-between md:items-start gap-4 mb-4">
                    <div>
                        <h3 class="heading text-2xl font-bold text-white group-hover:text-blue-400 transition-colors">{job.title}</h3>
                        <p class="text-slate-400 font-medium text-lg">{job.company}</p>
                    </div>
                    <span class="text-slate-500 font-mono text-sm border border-white/10 px-4 py-1 rounded-full bg-white/5">
                        {job.period}
                    </span>
                </div>
                <ul class="space-y-3">
                    {job.points.map(point => (
                        <li class="flex items-start gap-3 text-slate-400">
                            <span class="w-1.5 h-1.5 rounded-full bg-blue-600 mt-2 flex-shrink-0"></span>
                            <span class="leading-relaxed">{point}</span>
                        </li>
                    ))}
                </ul>
            </div>
        ))}
    </div>
</section>
