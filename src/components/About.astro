---
const { summary } = Astro.props;
---
<section id="about">
    <h2 class="heading text-sm font-bold uppercase tracking-[0.2em] text-blue-500 mb-6 flex items-center gap-4">
        About
        <div class="h-px flex-1 bg-white/5"></div>
    </h2>
    <p class="text-xl text-slate-300 leading-relaxed font-light">
        {summary}
    </p>
</section>
