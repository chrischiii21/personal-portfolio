---
import "../styles/global.css";

const profile = {
	name: "Christy M. Montejo",
	title: "Front-end Web Developer & UI/UX Designer",
	tagline: "I build high-performance web applications and design intuitive digital experiences that convert.",
	location: "Cebu City, Philippines",
	email: "christymontejo2003@gmail.com",
	github: "github.com/chrischiii21",
	linkedin: "linkedin.com/in/christymontejo",
	website: "christy-montejo.vercel.app",
};

const workExperience = [
	{
		role: "IT Intern (OJT)",
		organization: "N-compass TV",
		duration: "Jan 2026 – May 2026",
		location: "Cebu City, PH",
		achievements: [
			"Redesigned core UI/UX flows for internal platforms, improving user efficiency and screen management productivity.",
			"Leveraged collaborative vibe coding agents and Astro framework to develop and deploy responsive template galleries for diverse client trades (HVAC, Electrical, Plumbing), reducing client configuration time.",
			"Conducted rigorous QA testing and cross-browser validation to ensure 99.9% uptime for client-facing showcase modules."
		]
	}
];

const projects = [
	{
		name: "Internship Tracker",
		description: "Real-time tracker for administrative internship hours and task progress tracking.",
		tech: ["Astro", "Python", "TypeScript"]
	},
	{
		name: "Prompt Bucket",
		description: "Curated repository of prompt engineering patterns for high-fidelity generative AI media outputs.",
		tech: ["Astro", "TS", "Tailwind CSS"]
	}
];

const educationList = [
	{
		degree: "Bachelor of Science in Information Technology",
		institution: "Cebu Technological University - Argao Campus",
		period: "2022 – 2026"
	}
];

const achievements = [
	{
		title: "Proactive Optimization",
		description: "Initiated and led the migration of media-heavy template modules to Astro and Tailwind, reducing core page sizes and speeding up screen load times by 40%."
	},
	{
		title: "Technical Mentorship",
		description: "Organized Figma-to-code training sessions for fellow interns, establishing standardized component design systems that accelerated prototype deliveries."
	}
];

const techStack = [
	"Astro", "React.js", "Tailwind CSS", "TypeScript", "JavaScript (ES6+)", "Figma", "Python", 
	"Git / GitHub", "Vercel", "Node.js", "Bun Runtime", "PostgreSQL", "RESTful APIs", 
	"Prompt Engineering", "QA Testing", "CRO (Conversion Rate)", "Performance Optimization"
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>CV — {profile.name}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
		<style>
			body {
				font-family: 'Inter', sans-serif;
				line-height: 1.5;
				color: #1a1a1a;
				background-color: #f3f4f6;
			}
			.cv-container {
				max-width: 820px;
			}
			.section-header {
				font-weight: 800;
				letter-spacing: 0.07em;
			}
			@media print {
				body {
					background-color: white !important;
					color: black !important;
					font-size: 9.2pt !important;
					line-height: 1.32 !important;
					padding: 0 !important;
					margin: 0 !important;
					-webkit-print-color-adjust: exact !important;
					print-color-adjust: exact !important;
				}
				.no-print {
					display: none !important;
				}
				.cv-container {
					box-shadow: none !important;
					border: none !important;
					margin: 0 !important;
					padding: 0 !important;
					max-width: 100% !important;
					width: 100% !important;
				}
				@page {
					size: letter portrait;
					margin: 0.4in 0.45in;
				}
				.section-block {
					margin-bottom: 0.55rem !important;
					page-break-inside: avoid;
				}
				.section-title-container {
					margin-bottom: 0.25rem !important;
				}
				.entry-block {
					margin-bottom: 0.35rem !important;
					page-break-inside: avoid;
				}
				.bullet-list {
					margin-top: 0.1rem !important;
					gap: 0.05rem !important;
				}
				.tag-box {
					padding: 0.15rem 0.45rem !important;
					font-size: 7.8pt !important;
				}
				.achievement-text {
					font-size: 8.2pt !important;
				}
				.projects-grid {
					display: grid !important;
					grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
					gap: 0.75rem !important;
				}
				.project-text {
					font-size: 8.2pt !important;
				}
			}
		</style>
	</head>
	<body class="py-10 px-4 min-h-screen">
		<!-- Controls (Hidden during print) -->
		<div class="max-w-[820px] mx-auto mb-6 flex justify-between items-center no-print">
			<a href="/" class="text-gray-600 hover:text-black font-semibold flex items-center gap-2 transition-colors">
				<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
					<path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
				</svg>
				Portfolio
			</a>
			<button onclick="window.print()" class="bg-black text-white px-6 py-2 rounded-md font-bold hover:bg-gray-800 transition-all shadow-md flex items-center gap-2">
				<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
					<path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
				</svg>
				Print / PDF
			</button>
		</div>

		<!-- CV Paper Container -->
		<div class="cv-container mx-auto bg-white shadow-xl rounded-sm p-12 print:p-0 flex flex-col justify-between">
			<div>
				<!-- Header section -->
				<header class="text-left mb-5">
					<h1 class="text-3xl font-extrabold tracking-tight text-gray-900 uppercase mb-1">{profile.name}</h1>
					<p class="text-sm font-medium text-gray-600 italic mb-4 max-w-xl">{profile.tagline}</p>
					
					<!-- Contact details list in a single horizontal row -->
					<div class="flex flex-wrap justify-start items-center gap-x-6 gap-y-2 text-xs font-semibold text-gray-600 border-t border-b border-gray-100 py-2.5">
						<span class="flex items-center gap-1.5">
							<!-- Email Icon -->
							<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
							</svg>
							<a href={`mailto:${profile.email}`} class="hover:text-black transition-colors">{profile.email}</a>
						</span>
						<span class="flex items-center gap-1.5">
							<!-- Website Icon -->
							<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
							</svg>
							<a href={`https://${profile.website}`} target="_blank" class="hover:text-black transition-colors">{profile.website}</a>
						</span>
						<span class="flex items-center gap-1.5">
							<!-- LinkedIn Icon -->
							<svg xmlns="http://www.w3.org/2000/svg" class="w-4.5 h-4.5 text-gray-400" fill="currentColor" viewBox="0 0 24 24">
								<path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
							</svg>
							<a href={`https://${profile.linkedin}`} target="_blank" class="hover:text-black transition-colors">{profile.linkedin}</a>
						</span>
						<span class="flex items-center gap-1.5">
							<!-- GitHub Icon -->
							<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-400" fill="currentColor" viewBox="0 0 24 24">
								<path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.07 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0012 2z"/>
							</svg>
							<a href={`https://${profile.github}`} target="_blank" class="hover:text-black transition-colors">{profile.github}</a>
						</span>
					</div>
				</header>

				<!-- Experience Section -->
				<section class="section-block mb-5">
					<div class="section-title-container mb-2.5">
						<h2 class="section-header text-sm tracking-wider uppercase text-gray-900">Experience</h2>
						<div class="h-0 border-t-[1.5px] border-black w-full mt-0.5"></div>
					</div>
					<div class="space-y-3.5">
						{workExperience.map(exp => (
							<div class="entry-block">
								<div class="flex flex-col sm:flex-row sm:justify-between sm:items-baseline">
									<h3 class="text-sm font-bold text-gray-900 leading-tight">{exp.role}</h3>
									<div class="flex items-center gap-3 text-[11px] font-semibold text-gray-500 mt-0.5 sm:mt-0">
										<span class="flex items-center gap-1">
											<!-- Calendar Icon -->
											<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
												<path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
											</svg>
											{exp.duration}
										</span>
										<span class="flex items-center gap-1">
											<!-- Location Pin Icon -->
											<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
												<path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
												<path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
											</svg>
											{exp.location}
										</span>
									</div>
								</div>
								<p class="text-xs font-semibold text-gray-700 mt-0.5">{exp.organization}</p>
								<ul class="bullet-list list-disc list-outside pl-4 mt-1 flex flex-col gap-0.5">
									{exp.achievements.map(achievement => (
										<li class="text-[11.5px] text-gray-700 leading-normal pl-0.5">{achievement}</li>
									))}
								</ul>
							</div>
						))}
					</div>
				</section>

				<!-- Projects Section -->
				<section class="section-block mb-5">
					<div class="section-title-container mb-2.5">
						<div class="flex justify-between items-baseline flex-wrap gap-2">
							<h2 class="section-header text-sm tracking-wider uppercase text-gray-900">Featured Projects</h2>
							<span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest italic print:text-[8.5pt]">Vibe Coded / AI-Collaborative</span>
						</div>
						<div class="h-0 border-t-[1.5px] border-black w-full mt-0.5"></div>
					</div>
					<div class="projects-grid grid grid-cols-1 md:grid-cols-2 gap-4">
						{projects.map(proj => (
							<div class="entry-block flex flex-col justify-between h-full">
								<div>
									<h3 class="text-xs font-bold text-gray-900 uppercase tracking-wide">{proj.name}</h3>
									<p class="project-text text-[11px] text-gray-600 mt-1 leading-normal">{proj.description}</p>
								</div>
								<div class="flex flex-wrap gap-1 mt-2">
									{proj.tech.map(techName => (
										<span class="text-[9px] font-semibold text-gray-500 bg-gray-50 border border-gray-200 px-1.5 py-0.5 rounded-[2px]">{techName}</span>
									))}
								</div>
							</div>
						))}
					</div>
				</section>

				<!-- Education Section -->
				<section class="section-block mb-5">
					<div class="section-title-container mb-2.5">
						<h2 class="section-header text-sm tracking-wider uppercase text-gray-900">Education</h2>
						<div class="h-0 border-t-[1.5px] border-black w-full mt-0.5"></div>
					</div>
					<div class="space-y-3.5">
						{educationList.map(edu => (
							<div class="entry-block">
								<h3 class="text-sm font-bold text-gray-900 leading-tight">{edu.degree}</h3>
								<p class="text-xs font-semibold text-gray-700 mt-0.5">{edu.institution}</p>
								<span class="flex items-center gap-1 text-[11px] font-semibold text-gray-500 mt-1">
									<!-- Calendar Icon -->
									<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
										<path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
									</svg>
									{edu.period}
								</span>
							</div>
						))}
					</div>
				</section>

				<!-- Achievements Section -->
				<section class="section-block mb-5">
					<div class="section-title-container mb-2.5">
						<h2 class="section-header text-sm tracking-wider uppercase text-gray-900">Achievements</h2>
						<div class="h-0 border-t-[1.5px] border-black w-full mt-0.5"></div>
					</div>
					<div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-4">
						{achievements.map((ach, idx) => (
							<div class="flex gap-3 items-start">
								<div class="p-1.5 bg-gray-50 rounded-sm border border-gray-100 mt-0.5 print:bg-white print:border-none print:p-0">
									{idx === 0 ? (
										<!-- Trophy / Rocket Icon -->
										<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-gray-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
											<path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
										</svg>
									) : (
										<!-- Group / Mentoring Icon -->
										<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-gray-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
											<path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a3 3 0 11-6 0 3 3 0 016 0z" />
										</svg>
									)}
								</div>
								<div>
									<h3 class="text-xs font-bold text-gray-900 uppercase tracking-wide">{ach.title}</h3>
									<p class="achievement-text text-[11.5px] text-gray-600 mt-0.5 leading-normal">{ach.description}</p>
								</div>
							</div>
						))}
					</div>
				</section>

				<!-- Tech Stack Section -->
				<section class="section-block">
					<div class="section-title-container mb-2.5">
						<h2 class="section-header text-sm tracking-wider uppercase text-gray-900">Tech Stack</h2>
						<div class="h-0 border-t-[1.5px] border-black w-full mt-0.5"></div>
					</div>
					<div class="flex flex-wrap gap-2">
						{techStack.map(tech => (
							<span class="tag-box border border-gray-200 bg-white px-2.5 py-1 text-xs font-semibold text-gray-700 shadow-sm rounded-[2px] hover:border-gray-400 hover:text-black transition-colors cursor-default">
								{tech}
							</span>
						))}
					</div>
				</section>
			</div>

			<!-- Footer (Centered & Small) -->
			<footer class="mt-8 pt-4 border-t border-gray-100 text-center text-[10px] font-semibold text-gray-400 uppercase tracking-widest no-print">
				Curriculum Vitae • {profile.name} • {new Date().getFullYear()}
			</footer>
		</div>
	</body>
</html>
